{
  "family": "image-labeler",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::497502378363:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::497502378363:role/jcr-imageLabelerTaskRole",
  "containerDefinitions": [
    {
      "name": "image-labeler",
      "image": "497502378363.dkr.ecr.us-east-1.amazonaws.com/jcr-image-labeler:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "BUCKET_NAME", "value": "jcr-image-labeler" },
        { "name": "TABLE_NAME", "value": "jcr-ImageLabels" },
        { "name": "MIN_CONFIDENCE", "value": "70" },
        { "name": "MAX_LABELS", "value": "15" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/image-labeler",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}